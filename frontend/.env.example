# Usado por Vite en desarrollo (npm run dev) -- ajusta el puerto al que
# use tu backend local.
VITE_API_BASE_URL=http://localhost:8000

# Solo lo usa el servidor de producción (node server.js), no npm run dev --
# URL interna del backend en la red privada de Railway. Sin esto, server.js
# no arranca. Ver server.js para el porqué del proxy mismo-origen.
# BACKEND_INTERNAL_URL=http://backend.railway.internal:8080
